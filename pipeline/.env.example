# Neon: use the DIRECT connection string (no "-pooler") for the pipeline.
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning (defaults shown)
# ANALYSIS_MODEL=claude-haiku-4-5-20251001
# DAILY_ANALYSIS_LIMIT=30          # hard cap on Claude calls per rolling 24h (the cost ceiling)
# MAX_ANALYSES_PER_RUN=5
# MIN_OUTLETS_FOR_ANALYSIS=3
# SAME_LANG_THRESHOLD=0.66         # tune with: python -m nazariya.evaluate sweep labels.csv
# CROSS_LANG_THRESHOLD=0.58
# MERGE_THRESHOLD=0.78
# RETENTION_DAYS=14
# EMBEDDER=fastembed               # "hashing" is for tests only
