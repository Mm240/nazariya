# Neon: use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
PORT=3000
# Comma-separated list of sites allowed to call the API (your Vercel URL). Unset or * allows any.
CORS_ORIGINS=http://localhost:5173
DB_POOL_MAX=5
# Used for the cost estimate on the /api/stats endpoint (USD per million tokens, Claude Haiku 4.5).
INPUT_PRICE_PER_MTOK=1
OUTPUT_PRICE_PER_MTOK=5
# Salt for hashing anonymous reader ids (any long random string; keep it stable).
VISITOR_SALT=change-me-to-a-long-random-string
# Opens the moderation page at /admin. At least 16 characters; leave unset to disable moderation.
ADMIN_TOKEN=

# AI assistant (story chat and headline translation). Leave the key unset to switch it off.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_DAILY_LIMIT=500        # hard cap on Claude calls per UTC day (the cost ceiling)
